weserv_sources = files(
    'api_manager_impl.cpp',
    'io/source.cpp',
    'io/target.cpp',
    'parsers/color.cpp',
    'parsers/coordinate.cpp',
    'parsers/query.cpp',
    'processors/alignment.cpp',
    'processors/background.cpp',
    'processors/blur.cpp',
    'processors/contrast.cpp',
    'processors/crop.cpp',
    'processors/embed.cpp',
    'processors/filter.cpp',
    'processors/gamma.cpp',
    'processors/mask.cpp',
    'processors/modulate.cpp',
    'processors/orientation.cpp',
    'processors/rotation.cpp',
    'processors/sharpen.cpp',
    'processors/stream.cpp',
    'processors/thumbnail.cpp',
    'processors/tint.cpp',
    'processors/trim.cpp',
    'processors/watermark.cpp',
    'utils/status.cpp',
)

weserv_headers = files(
    'api_manager_impl.h',
    'enums.h',
    'exceptions/invalid.h',
    'exceptions/large.h',
    'exceptions/unreadable.h',
    'exceptions/unsupported.h',
    'io/source.h',
    'io/target.h',
    'parsers/color.h',
    'parsers/coordinate.h',
    'parsers/enumeration.h',
    'parsers/numeric.h',
    'parsers/query.h',
    'processors/alignment.h',
    'processors/background.h',
    'processors/base.h',
    'processors/blur.h',
    'processors/contrast.h',
    'processors/crop.h',
    'processors/embed.h',
    'processors/filter.h',
    'processors/gamma.h',
    'processors/mask.h',
    'processors/modulate.h',
    'processors/orientation.h',
    'processors/rotation.h',
    'processors/sharpen.h',
    'processors/stream.h',
    'processors/thumbnail.h',
    'processors/tint.h',
    'processors/trim.h',
    'processors/watermark.h',
    'utils/utility.h',
)

weserv_lib = library('weserv',
    weserv_sources,
    weserv_headers,
    dependencies: vips_dep,
    include_directories: weserv_includedir,
    version: library_version,
    gnu_symbol_visibility: 'hidden',
    install: true,
)

weserv_dep = declare_dependency(
    link_with: weserv_lib,
    dependencies: vips_dep,
    include_directories: weserv_includedir,
)

pkg.generate(
    weserv_lib,
    name: 'weserv',
    description: 'API library of the Nginx weserv module',
)
